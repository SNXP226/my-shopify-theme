{%- comment -%}
  Realistic clothes hanger used by the Clothing rack section.
  Pass `uid` (the section id) so it can use the shared gradients from 'clothing-rack-defs'.
{%- endcomment -%}
<svg class="clothing-rack__hanger" viewBox="0 0 200 84" aria-hidden="true" focusable="false">
  {%- comment -%} soft shadow under the shoulders {%- endcomment -%}
  <path d="M100 52 C 72 56, 36 66, 14 74 Q 100 70 186 74 C 164 66, 128 56, 100 52 Z" fill="#000" opacity="0.18" filter="url(#rack-blur-{{ uid }})"/>

  {%- comment -%} chrome hook {%- endcomment -%}
  <path d="M100 40 L100 28 C100 21 111 19 111 10.5 C111 4.5 106 1.8 99.5 1.8 C93 1.8 88.5 5.5 88.5 10.5" fill="none" stroke="#000" stroke-opacity="0.25" stroke-width="5.6" stroke-linecap="round" transform="translate(1.2 1.6)"/>
  <path d="M100 40 L100 28 C100 21 111 19 111 10.5 C111 4.5 106 1.8 99.5 1.8 C93 1.8 88.5 5.5 88.5 10.5" fill="none" stroke="url(#rack-chrome-{{ uid }})" stroke-width="5" stroke-linecap="round"/>
  <path d="M101.4 38.5 L101.4 28.5 C101.4 22.5 112 20 112 11" fill="none" stroke="#fff" stroke-opacity="0.6" stroke-width="1.1" stroke-linecap="round"/>

  {%- comment -%} shoulders (main body) {%- endcomment -%}
  <path d="M100 37 C 72 40, 34 52, 11 61 Q 2 64.5 5.5 70 Q 8.5 73.5 16 71.5 C 42 64, 76 56.5, 100 55 C 124 56.5, 158 64, 184 71.5 Q 191.5 73.5 194.5 70 Q 198 64.5 189 61 C 166 52, 128 40, 100 37 Z" fill="url(#rack-body-{{ uid }})"/>
  {%- comment -%} top highlight (light from above) {%- endcomment -%}
  <path d="M100 39.2 C 74 42, 38 53.5, 13 63" fill="none" stroke="#fff" stroke-opacity="0.32" stroke-width="1.6" stroke-linecap="round"/>
  <path d="M100 39.2 C 126 42, 162 53.5, 187 63" fill="none" stroke="#fff" stroke-opacity="0.2" stroke-width="1.6" stroke-linecap="round"/>
  {%- comment -%} bottom edge darkening {%- endcomment -%}
  <path d="M16 70.5 C 42 63, 76 55.5, 100 54 C 124 55.5, 158 63, 184 70.5" fill="none" stroke="#000" stroke-opacity="0.35" stroke-width="1.2"/>

  {%- comment -%} metal collar where the hook meets the body {%- endcomment -%}
  <rect x="95.5" y="34" width="9" height="7.5" rx="1.6" fill="url(#rack-chrome-{{ uid }})"/>
  <rect x="95.5" y="34" width="9" height="1.6" rx="0.8" fill="#fff" opacity="0.6"/>
</svg>
