{%- comment -%}
  Clothing Rack
  Products hang on a rail. Each product can have:
    - a FRONT photo  (the main product photo)
    - a SIDE photo   (write "side" in the photo's alt text) – shown while hanging on the rack
    - a BACK photo   (write "back" in the photo's alt text) – shown with the "Back" button
  Hovering swaps the side photo for the front photo, like pulling it off the rack.
  If there is no side photo, the front photo is turned sideways instead.
  Clicking opens a close-up with arrows, name, price and a shop button.
{%- endcomment -%}

{%- liquid
  assign rack_collection = section.settings.collection
  if rack_collection == blank
    assign rack_collection = collections.all
  endif
  assign rack_limit = section.settings.products_to_show
  assign rack_count = 0
  for product in rack_collection.products limit: rack_limit
    if product.featured_image
      assign rack_count = rack_count | plus: 1
    endif
  endfor
-%}

{%- if section.settings.use_brand_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

<clothing-rack
  class="clothing-rack clothing-rack--hanger-{{ section.settings.hanger_style }}{% if section.settings.draw_hangers %} clothing-rack--drawn-hangers{% endif %}{% if section.settings.use_brand_fonts %} clothing-rack--brand-fonts{% endif %}{% if section.settings.blend_backgrounds %} clothing-rack--blend{% endif %}"
  style="
    --rack-bg: {{ section.settings.background_color }};
    --rack-fg: {{ section.settings.text_color }};
    --rack-ticker-bg: {{ section.settings.ticker_background }};
    --rack-ticker-fg: {{ section.settings.ticker_text_color }};
    --rack-accent: {{ section.settings.accent_color }};
    --rack-height: {{ section.settings.section_height }}svh;
    --rack-garment-h: {{ section.settings.garment_height }}px;
    --rack-collapsed: {{ section.settings.spacing }}px;
    --rack-photo-shift: {{ section.settings.photo_shift }}px;
  "
  data-section-id="{{ section.id }}"
>
  {%- if section.settings.draw_hangers -%}
    {% render 'clothing-rack-defs', uid: section.id %}
  {%- endif -%}

  <div class="clothing-rack__stage">
    {%- if section.settings.heading != blank -%}
      <h2 class="clothing-rack__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="clothing-rack__rail-wrap">
      <div class="clothing-rack__scroller">
        <div class="clothing-rack__track">
          <div class="clothing-rack__rail" aria-hidden="true">
            <span class="clothing-rack__mount"></span>
            <span class="clothing-rack__rod"></span>
            <span class="clothing-rack__mount"></span>
          </div>

          <ul class="clothing-rack__items" role="list">
            {%- if rack_count > 0 -%}
              {%- assign item_index = 0 -%}
              {%- for product in rack_collection.products limit: rack_limit -%}
                {%- if product.featured_image -%}
                  {%- liquid
                    assign front_image = blank
                    assign side_image = blank
                    for img in product.images
                      assign alt_lower = img.alt | downcase
                      if side_image == blank and alt_lower contains 'side'
                        assign side_image = img
                      elsif front_image == blank and alt_lower contains 'back'
                        continue
                      elsif front_image == blank and alt_lower contains 'side'
                        continue
                      elsif front_image == blank
                        assign front_image = img
                      endif
                    endfor
                    if front_image == blank
                      assign front_image = product.featured_image
                    endif
                  -%}
                  <li class="clothing-rack__item{% if side_image != blank %} has-side{% endif %}">
                    <button
                      type="button"
                      class="clothing-rack__garment"
                      data-index="{{ item_index }}"
                      aria-label="{{ product.title | escape }}"
                    >
                      <span class="clothing-rack__shadow" aria-hidden="true"></span>
                      {%- if side_image != blank -%}
                        <img
                          class="clothing-rack__img clothing-rack__img--side"
                          src="{{ side_image | image_url: width: 500 }}"
                          alt=""
                          loading="{% if forloop.index <= 8 %}eager{% else %}lazy{% endif %}"
                          width="{{ side_image.width }}"
                          height="{{ side_image.height }}"
                        >
                      {%- endif -%}
                      <img
                        class="clothing-rack__img clothing-rack__img--front"
                        src="{{ front_image | image_url: width: 700 }}"
                        alt=""
                        loading="{% if forloop.index <= 8 %}eager{% else %}lazy{% endif %}"
                        width="{{ front_image.width }}"
                        height="{{ front_image.height }}"
                      >
                      {%- if section.settings.draw_hangers -%}
                        <span class="clothing-rack__hanger-wrap">
                          {%- render 'clothing-rack-hanger', uid: section.id -%}
                        </span>
                      {%- endif -%}
                    </button>
                  </li>
                  {%- assign item_index = item_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..6) -%}
                <li class="clothing-rack__item">
                  <span class="clothing-rack__garment clothing-rack__garment--placeholder">
                    {%- capture placeholder_name -%}apparel-{{ forloop.index | modulo: 8 | plus: 1 }}{%- endcapture -%}
                    {{ placeholder_name | placeholder_svg_tag: 'clothing-rack__img clothing-rack__img--front clothing-rack__img--placeholder' }}
                  </span>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>

    {%- if section.settings.hint != blank and rack_count > 0 -%}
      <p class="clothing-rack__hint">{{ section.settings.hint }}</p>
    {%- endif -%}

    {%- if rack_count > 0 -%}
      <div class="clothing-rack__focus" role="dialog" aria-modal="false" aria-label="Product" hidden>
        <button type="button" class="clothing-rack__close" data-rack-close>
          {{ section.settings.close_label | default: 'Close' }} <span aria-hidden="true">&times;</span>
        </button>

        <button type="button" class="clothing-rack__arrow clothing-rack__arrow--prev" data-rack-prev aria-label="Previous item">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <button type="button" class="clothing-rack__arrow clothing-rack__arrow--next" data-rack-next aria-label="Next item">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>

        <div class="clothing-rack__focus-stage">
          <img class="clothing-rack__ghost clothing-rack__ghost--prev" alt="" data-rack-ghost-prev>
          <figure class="clothing-rack__hero" data-rack-hero>
            <span class="clothing-rack__hero-shadow" aria-hidden="true"></span>
            <img class="clothing-rack__hero-img" alt="" data-rack-hero-img>
            {%- if section.settings.draw_hangers -%}
              {%- render 'clothing-rack-hanger', uid: section.id -%}
            {%- endif -%}
          </figure>
          <img class="clothing-rack__ghost clothing-rack__ghost--next" alt="" data-rack-ghost-next>
        </div>

        <div class="clothing-rack__info">
          <h3 class="clothing-rack__title" data-rack-title></h3>
          <p class="clothing-rack__price">
            <span data-rack-price></span>
            <s class="clothing-rack__compare" data-rack-compare></s>
            <span class="clothing-rack__soldout" data-rack-soldout hidden>{{ section.settings.sold_out_label }}</span>
          </p>
          <div class="clothing-rack__actions">
            <a class="clothing-rack__btn clothing-rack__btn--solid" href="#" data-rack-link>
              {{- section.settings.shop_label -}}
            </a>
            <button type="button" class="clothing-rack__btn" data-rack-flip hidden>
              {{- section.settings.back_label -}}
            </button>
          </div>
        </div>
      </div>

      <script type="application/json" data-rack-products>
        [
          {%- assign first = true -%}
          {%- for product in rack_collection.products limit: rack_limit -%}
            {%- if product.featured_image -%}
              {%- unless first -%},{%- endunless -%}
              {%- assign first = false -%}
              {%- liquid
                assign front_image = blank
                assign back_image = blank
                for img in product.images
                  assign alt_lower = img.alt | downcase
                  if back_image == blank and alt_lower contains 'back'
                    assign back_image = img
                  elsif alt_lower contains 'side'
                    continue
                  elsif front_image == blank and alt_lower contains 'back'
                    continue
                  elsif front_image == blank
                    assign front_image = img
                  endif
                endfor
                if front_image == blank
                  assign front_image = product.featured_image
                endif
              -%}
              {
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "price": {{ product.price | money | strip_html | json }},
                "compare": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
                "available": {{ product.available | json }},
                "alt": {{ front_image.alt | default: product.title | json }},
                "front": {{ front_image | image_url: width: 1400 | json }},
                "back": {% if back_image != blank %}{{ back_image | image_url: width: 1400 | json }}{% else %}null{% endif %}
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>

  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    <div class="clothing-rack__ticker" aria-label="{{ section.settings.ticker_text | escape }}">
      <div class="clothing-rack__ticker-track" aria-hidden="true">
        {%- for i in (1..2) -%}
          <div class="clothing-rack__ticker-group">
            {%- for j in (1..4) -%}
              {%- if section.settings.ticker_separator != blank -%}
                {%- assign ticker_parts = section.settings.ticker_text | split: section.settings.ticker_separator -%}
                {%- for part in ticker_parts -%}
                  {%- assign part_text = part | strip -%}
                  {%- if part_text != blank -%}
                    <span>{{ part_text }}</span>
                    <span class="clothing-rack__ticker-sep">{{ section.settings.ticker_separator }}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <span>{{ section.settings.ticker_text }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</clothing-rack>

{% stylesheet %}
  .clothing-rack {
    --rack-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --rack-open: calc(var(--rack-garment-h) * 0.8);
    --rack-rod-top: 6px;
    --hanger-w: calc(var(--rack-open) * 0.62);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: var(--rack-height);
    background-color: var(--rack-bg);
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.18), rgb(255 255 255 / 0) 60%);
    color: var(--rack-fg);
    overflow: hidden;
  }

  .clothing-rack__stage {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 0 40px;
  }

  .clothing-rack__heading {
    margin: 0 0 40px;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
  }

  /* ---------- Rack ---------- */
  .clothing-rack__rail-wrap {
    width: 100%;
    transition: opacity 0.5s var(--rack-ease), transform 0.6s var(--rack-ease), filter 0.5s;
  }

  .clothing-rack__scroller {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  .clothing-rack__scroller::-webkit-scrollbar {
    display: none;
  }

  .clothing-rack__track {
    box-sizing: border-box;
    position: relative;
    width: max-content;
    min-width: min(100%, 880px);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Thin chrome rod with small wall mounts */
  .clothing-rack__rail {
    position: absolute;
    top: var(--rack-rod-top);
    left: 24px;
    right: 24px;
    display: flex;
    align-items: center;
    height: 4px;
    pointer-events: none;
  }

  .clothing-rack__rod {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(180deg, #f7f7f7 0%, #c4c4c4 40%, #8d8d8d 75%, #a9a9a9 100%);
    box-shadow: 0 3px 4px rgb(0 0 0 / 0.12);
  }

  .clothing-rack__mount {
    flex: 0 0 auto;
    width: 6px;
    height: 12px;
    border-radius: 2px;
    background: linear-gradient(90deg, #8a8a8a, #ededed 45%, #9b9b9b);
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.18);
  }

  .clothing-rack__items {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0 28px;
    list-style: none;
  }

  .clothing-rack__item {
    position: relative;
    flex: 0 0 auto;
    width: var(--rack-collapsed);
    height: calc(var(--rack-garment-h) + var(--rack-photo-shift) + 8px);
    transition: width 0.55s var(--rack-ease);
  }

  .clothing-rack--drawn-hangers .clothing-rack__item {
    height: calc(var(--rack-garment-h) + var(--hanger-w) * 0.26 + var(--rack-photo-shift) + 8px);
  }

  .clothing-rack__garment {
    all: unset;
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .clothing-rack__garment--placeholder {
    cursor: default;
  }

  /* Photos */
  .clothing-rack__img {
    --turn: 0deg;
    position: absolute;
    top: var(--rack-photo-shift);
    left: 50%;
    height: var(--rack-garment-h);
    width: var(--rack-open);
    object-fit: contain;
    object-position: top center;
    transform: translateX(-50%) perspective(1000px) rotateY(var(--turn));
    transition: transform 0.55s var(--rack-ease), opacity 0.35s ease;
    pointer-events: none;
    user-select: none;
  }

  .clothing-rack--drawn-hangers .clothing-rack__img {
    top: calc(var(--hanger-w) * 0.26 + var(--rack-photo-shift));
  }

  /* Side photo shows while hanging; front photo appears on hover */
  .clothing-rack__item.has-side .clothing-rack__img--front {
    opacity: 0;
    transform: translateX(-50%) scale(0.97);
  }

  /* No side photo: turn the front photo sideways instead */
  .clothing-rack__item:not(.has-side) .clothing-rack__img--front {
    --turn: 70deg;
  }

  .clothing-rack--blend .clothing-rack__img,
  .clothing-rack--blend .clothing-rack__hero-img,
  .clothing-rack--blend .clothing-rack__ghost {
    mix-blend-mode: multiply;
  }

  .clothing-rack__img--placeholder {
    fill: rgb(0 0 0 / 0.3);
  }

  /* Soft shadow on the wall (light comes from the upper right) */
  .clothing-rack__shadow {
    position: absolute;
    top: calc(var(--rack-photo-shift) + var(--rack-garment-h) * 0.12);
    left: 50%;
    width: 60%;
    height: calc(var(--rack-garment-h) * 0.78);
    border-radius: 40% 40% 12% 12% / 14% 14% 8% 8%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(14px);
    opacity: 0.1;
    transform: translateX(calc(-50% - 6px));
    transition: opacity 0.55s var(--rack-ease), transform 0.55s var(--rack-ease), width 0.55s var(--rack-ease);
    pointer-events: none;
  }

  /* Optional drawn hanger (only for photos without a hanger) */
  .clothing-rack__hanger-wrap {
    position: absolute;
    top: var(--rack-photo-shift);
    left: 50%;
    width: var(--hanger-w);
    transform: translateX(-50%) perspective(1000px) rotateY(70deg);
    transition: transform 0.55s var(--rack-ease);
    pointer-events: none;
  }

  .clothing-rack__hanger {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ----- Pull out: hover (mouse) or keyboard focus ----- */
  @media (hover: hover) {
    .clothing-rack__item:has(.clothing-rack__garment:not(.clothing-rack__garment--placeholder):hover) {
      width: var(--rack-open);
    }

    .clothing-rack__garment:hover .clothing-rack__img--front {
      --turn: 0deg;
      opacity: 1;
      transform: translateX(-50%) perspective(1000px) rotateY(0deg);
    }

    .clothing-rack__item.has-side .clothing-rack__garment:hover .clothing-rack__img--side {
      opacity: 0;
    }

    .clothing-rack__garment:hover .clothing-rack__shadow {
      opacity: 0.2;
      width: 76%;
      transform: translateX(calc(-50% - 14px)) translateY(6px);
    }

    .clothing-rack__garment:hover .clothing-rack__hanger-wrap {
      transform: translateX(-50%) perspective(1000px) rotateY(0deg);
    }
  }

  .clothing-rack__item:has(.clothing-rack__garment:focus-visible) {
    width: var(--rack-open);
  }

  .clothing-rack__garment:focus-visible .clothing-rack__img--front {
    opacity: 1;
    transform: translateX(-50%) perspective(1000px) rotateY(0deg);
  }

  .clothing-rack__item.has-side .clothing-rack__garment:focus-visible .clothing-rack__img--side {
    opacity: 0;
  }

  .clothing-rack__garment:focus-visible .clothing-rack__hanger-wrap {
    transform: translateX(-50%) perspective(1000px) rotateY(0deg);
  }

  .clothing-rack__garment:focus-visible::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 0;
    height: 1px;
    background: currentColor;
  }

  .clothing-rack__hint {
    margin: 28px 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 0.4s;
  }

  /* ---------- Close-up view ---------- */
  .clothing-rack.is-focused .clothing-rack__rail-wrap {
    opacity: 0;
    transform: scale(0.97);
    filter: blur(6px);
    pointer-events: none;
  }

  .clothing-rack.is-focused .clothing-rack__hint,
  .clothing-rack.is-focused .clothing-rack__heading {
    opacity: 0;
  }

  .clothing-rack__focus {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 52px 16px 24px;
    opacity: 0;
    transition: opacity 0.45s var(--rack-ease);
  }

  .clothing-rack__focus[hidden] {
    display: none;
  }

  .clothing-rack.is-open .clothing-rack__focus {
    opacity: 1;
  }

  .clothing-rack__close {
    all: unset;
    position: absolute;
    top: 16px;
    right: 20px;
    padding: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .clothing-rack__close:focus-visible,
  .clothing-rack__arrow:focus-visible,
  .clothing-rack__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .clothing-rack__arrow {
    all: unset;
    position: absolute;
    top: 44%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid currentColor;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s;
  }

  .clothing-rack__arrow[hidden] {
    display: none;
  }

  .clothing-rack__arrow:hover {
    opacity: 1;
  }

  .clothing-rack__arrow--prev {
    left: max(16px, 4vw);
  }

  .clothing-rack__arrow--next {
    right: max(16px, 4vw);
  }

  .clothing-rack__focus-stage {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 900px;
    height: min(calc(var(--rack-garment-h) * 1.4), 60svh);
  }

  .clothing-rack__hero {
    --hero-hanger-w: min(190px, 40vw);
    position: relative;
    height: 100%;
    width: min(72vw, 520px);
    margin: 0;
  }

  .clothing-rack__hero > * {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    transition: opacity 0.35s var(--rack-ease), transform 0.5s var(--rack-ease);
  }

  .clothing-rack__hero-img {
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
  }

  .clothing-rack--drawn-hangers .clothing-rack__hero-img {
    top: calc(var(--hero-hanger-w) * 0.26);
    height: calc(100% - var(--hero-hanger-w) * 0.26);
  }

  .clothing-rack__hero .clothing-rack__hanger {
    top: 0;
    width: var(--hero-hanger-w);
  }

  .clothing-rack__hero-shadow {
    top: 10%;
    width: 58%;
    height: 80%;
    border-radius: 40% 40% 12% 12% / 14% 14% 8% 8%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(24px);
    opacity: 0.18;
    transform: translateX(calc(-50% - 26px)) translateY(14px);
  }

  .clothing-rack__hero.is-swapping > * {
    opacity: 0;
    transform: translateX(calc(-50% + var(--rack-swap-dir, 0px))) scale(0.98);
  }

  .clothing-rack__hero.is-swapping > .clothing-rack__hero-shadow {
    transform: translateX(calc(-50% - 26px + var(--rack-swap-dir, 0px))) translateY(14px);
  }

  .clothing-rack__ghost {
    position: absolute;
    top: 6%;
    height: 82%;
    width: auto;
    max-width: 26%;
    object-fit: contain;
    opacity: 0.28;
    filter: blur(6px);
    pointer-events: none;
    transition: opacity 0.4s;
  }

  .clothing-rack__ghost--prev {
    left: 8%;
  }

  .clothing-rack__ghost--next {
    right: 8%;
  }

  .clothing-rack__ghost:not([src]),
  .clothing-rack__ghost[src=''] {
    visibility: hidden;
  }

  .clothing-rack__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .clothing-rack__title {
    margin: 0;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
  }

  .clothing-rack__price {
    margin: 0;
    display: flex;
    gap: 8px;
    font-size: 0.8rem;
  }

  .clothing-rack__compare {
    opacity: 0.5;
  }

  .clothing-rack__compare:empty {
    display: none;
  }

  .clothing-rack__soldout {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rack-accent);
  }

  .clothing-rack__actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .clothing-rack__btn {
    all: unset;
    box-sizing: border-box;
    padding: 9px 20px;
    border: 1px solid var(--rack-fg);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .clothing-rack__btn:hover {
    background: var(--rack-fg);
    color: var(--rack-bg);
  }

  .clothing-rack__btn--solid {
    background: var(--rack-fg);
    color: var(--rack-bg);
  }

  .clothing-rack__btn--solid:hover {
    background: var(--rack-accent);
    border-color: var(--rack-accent);
    color: var(--rack-bg);
  }

  .clothing-rack__btn[hidden] {
    display: none;
  }

  /* ---------- Scrolling bar ---------- */
  .clothing-rack__ticker {
    position: relative;
    z-index: 4;
    overflow: hidden;
    background: var(--rack-ticker-bg);
    color: var(--rack-ticker-fg);
    padding: 7px 0;
  }

  .clothing-rack__ticker-track {
    display: flex;
    width: max-content;
    animation: clothing-rack-ticker 40s linear infinite;
  }

  .clothing-rack__ticker-group {
    display: flex;
    flex-shrink: 0;
  }

  .clothing-rack__ticker-group span {
    padding: 0 12px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .clothing-rack__ticker-sep {
    color: var(--rack-accent);
  }

  @keyframes clothing-rack-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Brand fonts ---------- */
  .clothing-rack--brand-fonts {
    --rack-font-display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    --rack-font-mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    font-family: var(--rack-font-mono);
  }

  .clothing-rack--brand-fonts .clothing-rack__heading,
  .clothing-rack--brand-fonts .clothing-rack__title,
  .clothing-rack--brand-fonts .clothing-rack__ticker-group span {
    font-family: var(--rack-font-display);
    font-weight: 400;
  }

  .clothing-rack--brand-fonts .clothing-rack__title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .clothing-rack--brand-fonts .clothing-rack__heading {
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.08em;
  }

  .clothing-rack--brand-fonts .clothing-rack__ticker-group span {
    font-size: 1.05rem;
    letter-spacing: 0.12em;
  }

  /* Hanger colors (only used with drawn hangers) */
  .clothing-rack--hanger-black {
    --hanger-light: #57534e;
    --hanger-mid: #2a2826;
    --hanger-dark: #0d0c0b;
  }

  .clothing-rack--hanger-wood {
    --hanger-light: #c99a66;
    --hanger-mid: #8a5a2e;
    --hanger-dark: #4e3018;
  }

  .clothing-rack--hanger-chrome {
    --hanger-light: #fbfbfb;
    --hanger-mid: #a7a7a7;
    --hanger-dark: #4f4f4f;
  }

  .clothing-rack__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* ---------- Phones ---------- */
  @media (max-width: 749px) {
    .clothing-rack {
      --rack-garment-h: 240px !important;
      min-height: min(var(--rack-height), 78svh);
    }

    .clothing-rack__item {
      width: calc(var(--rack-collapsed) * 0.8);
    }

    .clothing-rack__ghost {
      display: none;
    }

    .clothing-rack__arrow {
      top: auto;
      bottom: 24px;
    }

    .clothing-rack__arrow--prev {
      left: 16px;
    }

    .clothing-rack__arrow--next {
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clothing-rack *,
    .clothing-rack {
      transition-duration: 0.01ms !important;
    }

    .clothing-rack__ticker-track {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('clothing-rack')) {
    class ClothingRack extends HTMLElement {
      connectedCallback() {
        const dataEl = this.querySelector('[data-rack-products]');
        this.focusEl = this.querySelector('.clothing-rack__focus');
        if (!dataEl || !this.focusEl) return;

        try {
          this.products = JSON.parse(dataEl.textContent);
        } catch (e) {
          this.products = [];
        }
        if (!this.products.length) return;

        this.index = 0;
        this.showingBack = false;
        this.els = {
          hero: this.querySelector('[data-rack-hero]'),
          heroImg: this.querySelector('[data-rack-hero-img]'),
          ghostPrev: this.querySelector('[data-rack-ghost-prev]'),
          ghostNext: this.querySelector('[data-rack-ghost-next]'),
          title: this.querySelector('[data-rack-title]'),
          price: this.querySelector('[data-rack-price]'),
          compare: this.querySelector('[data-rack-compare]'),
          soldout: this.querySelector('[data-rack-soldout]'),
          link: this.querySelector('[data-rack-link]'),
          flip: this.querySelector('[data-rack-flip]'),
        };
        this.backLabel = this.els.flip.textContent.trim();

        this.onClick = (event) => {
          const garment = event.target.closest('.clothing-rack__garment[data-index]');
          if (garment) {
            this.lastTrigger = garment;
            this.open(Number(garment.dataset.index));
            return;
          }
          if (event.target.closest('[data-rack-close]')) this.close();
          else if (event.target.closest('[data-rack-prev]')) this.step(-1);
          else if (event.target.closest('[data-rack-next]')) this.step(1);
          else if (event.target.closest('[data-rack-flip]')) this.flip();
        };

        this.onKey = (event) => {
          if (!this.classList.contains('is-focused')) return;
          if (event.key === 'Escape') this.close();
          else if (event.key === 'ArrowLeft') this.step(-1);
          else if (event.key === 'ArrowRight') this.step(1);
        };

        this.addEventListener('click', this.onClick);
        document.addEventListener('keydown', this.onKey);

        let touchX = null;
        this.focusEl.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
        this.focusEl.addEventListener('touchend', (e) => {
          if (touchX === null) return;
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 50) this.step(dx < 0 ? 1 : -1);
          touchX = null;
        });
      }

      disconnectedCallback() {
        if (this.onKey) document.removeEventListener('keydown', this.onKey);
      }

      wrap(i) {
        const n = this.products.length;
        return ((i % n) + n) % n;
      }

      render() {
        const p = this.products[this.index];
        const n = this.products.length;
        this.showingBack = false;

        this.els.heroImg.src = p.front;
        this.els.heroImg.alt = p.alt || p.title;
        this.els.title.textContent = p.title;
        this.els.price.textContent = p.price;
        this.els.compare.textContent = p.compare || '';
        this.els.soldout.hidden = p.available;
        this.els.link.href = p.url;
        this.els.flip.hidden = !p.back;
        this.els.flip.textContent = this.backLabel;

        if (n > 1) {
          this.els.ghostPrev.src = this.products[this.wrap(this.index - 1)].front;
          this.els.ghostNext.src = this.products[this.wrap(this.index + 1)].front;
        } else {
          this.els.ghostPrev.removeAttribute('src');
          this.els.ghostNext.removeAttribute('src');
        }

        this.querySelectorAll('[data-rack-prev], [data-rack-next]').forEach((b) => (b.hidden = n < 2));
      }

      open(i) {
        this.index = this.wrap(i);
        this.render();
        this.focusEl.hidden = false;
        this.classList.add('is-focused');
        requestAnimationFrame(() => {
          this.classList.add('is-open');
          this.querySelector('[data-rack-close]').focus({ preventScroll: true });
        });
      }

      close() {
        this.classList.remove('is-open', 'is-focused');
        clearTimeout(this.hideTimer);
        this.hideTimer = setTimeout(() => {
          if (!this.classList.contains('is-focused')) this.focusEl.hidden = true;
        }, 450);
        if (this.lastTrigger) this.lastTrigger.focus({ preventScroll: true });
      }

      step(dir) {
        if (this.products.length < 2 || this.swapping) return;
        this.swapping = true;
        const hero = this.els.hero;
        hero.style.setProperty('--rack-swap-dir', `${dir * -40}px`);
        hero.classList.add('is-swapping');
        setTimeout(() => {
          this.index = this.wrap(this.index + dir);
          this.render();
          hero.style.setProperty('--rack-swap-dir', `${dir * 40}px`);
          requestAnimationFrame(() => {
            hero.classList.remove('is-swapping');
            this.swapping = false;
          });
        }, 220);
      }

      flip() {
        const p = this.products[this.index];
        if (!p.back) return;
        this.showingBack = !this.showingBack;
        this.els.heroImg.src = this.showingBack ? p.back : p.front;
        this.els.flip.textContent = this.showingBack ? 'Front' : this.backLabel;
      }
    }

    customElements.define('clothing-rack', ClothingRack);
  }
{% endjavascript %}

