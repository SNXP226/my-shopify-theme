{%- comment -%}
  Clothing Rack
  Shows products hanging sideways on a rail. Hover pulls a garment out to face forward,
  click opens a large close-up with previous/next arrows, name, price and a shop button.
  A scrolling ticker runs along the bottom.
{%- endcomment -%}

{%- liquid
  assign rack_collection = section.settings.collection
  if rack_collection == blank
    assign rack_collection = collections.all
  endif
  assign rack_limit = section.settings.products_to_show
  assign rack_count = 0
  for product in rack_collection.products limit: rack_limit
    if product.featured_image
      assign rack_count = rack_count | plus: 1
    endif
  endfor
-%}

{%- if section.settings.use_brand_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

<clothing-rack
  class="clothing-rack clothing-rack--hanger-{{ section.settings.hanger_style }}{% if section.settings.use_brand_fonts %} clothing-rack--brand-fonts{% endif %}{% if section.settings.blend_backgrounds %} clothing-rack--blend{% endif %}"
  style="
    --rack-bg: {{ section.settings.background_color }};
    --rack-fg: {{ section.settings.text_color }};
    --rack-ticker-bg: {{ section.settings.ticker_background }};
    --rack-ticker-fg: {{ section.settings.ticker_text_color }};
    --rack-accent: {{ section.settings.accent_color }};
    --rack-height: {{ section.settings.section_height }}svh;
    --rack-garment-h: {{ section.settings.garment_height }}px;
  "
  data-section-id="{{ section.id }}"
>
  {% render 'clothing-rack-defs', uid: section.id %}
  <div class="clothing-rack__stage">
    {%- if section.settings.heading != blank -%}
      <h2 class="clothing-rack__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="clothing-rack__rail-wrap">
      <div class="clothing-rack__scroller">
        <div class="clothing-rack__track">
        <div class="clothing-rack__rail" aria-hidden="true">
          <span class="clothing-rack__bracket clothing-rack__bracket--left"></span>
          <span class="clothing-rack__rail-bar"></span>
          <span class="clothing-rack__bracket clothing-rack__bracket--right"></span>
        </div>

        <ul class="clothing-rack__items" role="list">
          {%- if rack_count > 0 -%}
            {%- assign item_index = 0 -%}
            {%- for product in rack_collection.products limit: rack_limit -%}
              {%- if product.featured_image -%}
                <li class="clothing-rack__item">
                  <button
                    type="button"
                    class="clothing-rack__garment"
                    data-index="{{ item_index }}"
                    aria-label="{{ product.title | escape }}"
                  >
                    <span class="clothing-rack__shadow clothing-rack__turn" aria-hidden="true"></span>
                    <img
                        class="clothing-rack__img clothing-rack__turn"
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                        sizes="260px"
                        alt=""
                        loading="{% if forloop.index <= 8 %}eager{% else %}lazy{% endif %}"
                        width="{{ product.featured_image.width }}"
                        height="{{ product.featured_image.height }}"
                      >
                    <span class="clothing-rack__hanger-wrap clothing-rack__turn">
                      {%- render 'clothing-rack-hanger', uid: section.id -%}
                    </span>
                    <span class="clothing-rack__label">{{ product.title }}</span>
                  </button>
                </li>
                {%- assign item_index = item_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <li class="clothing-rack__item">
                <span class="clothing-rack__garment clothing-rack__garment--placeholder">
                  {%- capture placeholder_name -%}apparel-{{ forloop.index | modulo: 8 | plus: 1 }}{%- endcapture -%}
                  {{ placeholder_name | placeholder_svg_tag: 'clothing-rack__img clothing-rack__img--placeholder clothing-rack__turn' }}
                  <span class="clothing-rack__hanger-wrap clothing-rack__turn">
                    {%- render 'clothing-rack-hanger', uid: section.id -%}
                  </span>
                </span>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        </div>
      </div>
    </div>

    {%- if section.settings.hint != blank and rack_count > 0 -%}
      <p class="clothing-rack__hint">{{ section.settings.hint }}</p>
    {%- endif -%}

    {%- if rack_count > 0 -%}
      <div class="clothing-rack__focus" role="dialog" aria-modal="false" aria-label="{{ 'Product' | escape }}" hidden>
        <button type="button" class="clothing-rack__close" data-rack-close>
          {{ section.settings.close_label | default: 'Close' }} <span aria-hidden="true">&times;</span>
        </button>

        <button type="button" class="clothing-rack__arrow clothing-rack__arrow--prev" data-rack-prev aria-label="Previous item">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <button type="button" class="clothing-rack__arrow clothing-rack__arrow--next" data-rack-next aria-label="Next item">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>

        <div class="clothing-rack__focus-stage">
          <img class="clothing-rack__ghost clothing-rack__ghost--prev" alt="" data-rack-ghost-prev>
          <figure class="clothing-rack__hero" data-rack-hero>
            <span class="clothing-rack__hero-shadow" aria-hidden="true"></span>
            <img class="clothing-rack__hero-img" alt="" data-rack-hero-img>
            {%- render 'clothing-rack-hanger', uid: section.id -%}
          </figure>
          <img class="clothing-rack__ghost clothing-rack__ghost--next" alt="" data-rack-ghost-next>
        </div>

        <div class="clothing-rack__info">
          <h3 class="clothing-rack__title" data-rack-title></h3>
          <p class="clothing-rack__price">
            <span data-rack-price></span>
            <s class="clothing-rack__compare" data-rack-compare></s>
            <span class="clothing-rack__soldout" data-rack-soldout hidden>{{ section.settings.sold_out_label }}</span>
          </p>
          <div class="clothing-rack__actions">
            <a class="clothing-rack__btn clothing-rack__btn--solid" href="#" data-rack-link>
              {{- section.settings.shop_label -}}
            </a>
            <button type="button" class="clothing-rack__btn" data-rack-flip hidden>
              {{- section.settings.back_label -}}
            </button>
          </div>
        </div>
      </div>

      <script type="application/json" data-rack-products>
        [
          {%- assign first = true -%}
          {%- for product in rack_collection.products limit: rack_limit -%}
            {%- if product.featured_image -%}
              {%- unless first -%},{%- endunless -%}
              {%- assign first = false -%}
              {%- liquid
                assign back_image = blank
                for img in product.images
                  if img.id != product.featured_image.id
                    assign back_image = img
                    break
                  endif
                endfor
              -%}
              {
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "price": {{ product.price | money | strip_html | json }},
                "compare": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
                "available": {{ product.available | json }},
                "alt": {{ product.featured_image.alt | default: product.title | json }},
                "front": {{ product.featured_image | image_url: width: 1400 | json }},
                "back": {% if back_image != blank %}{{ back_image | image_url: width: 1400 | json }}{% else %}null{% endif %}
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>

  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    <div class="clothing-rack__ticker" aria-label="{{ section.settings.ticker_text | escape }}">
      <div class="clothing-rack__ticker-track" aria-hidden="true">
        {%- for i in (1..2) -%}
          <div class="clothing-rack__ticker-group">
            {%- for j in (1..4) -%}
              {%- if section.settings.ticker_separator != blank -%}
                {%- assign ticker_parts = section.settings.ticker_text | split: section.settings.ticker_separator -%}
                {%- for part in ticker_parts -%}
                  {%- assign part_text = part | strip -%}
                  {%- if part_text != blank -%}
                    <span>{{ part_text }}</span>
                    <span class="clothing-rack__ticker-sep">{{ section.settings.ticker_separator }}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <span>{{ section.settings.ticker_text }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</clothing-rack>

{% stylesheet %}
  .clothing-rack {
    --rack-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --rack-collapsed: 58px;
    --rack-open: calc(var(--rack-garment-h) * 0.78);
    position: relative;
    display: flex;
    flex-direction: column;
    --hanger-w: calc(var(--rack-open) * 0.68);
    min-height: var(--rack-height);
    background-color: var(--rack-bg);
    background-image:
      radial-gradient(60% 55% at 50% 18%, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0) 70%),
      radial-gradient(140% 100% at 50% 40%, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.14) 100%);
    color: var(--rack-fg);
    overflow: hidden;
  }

  .clothing-rack__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Hanger colors */
  .clothing-rack--hanger-black {
    --hanger-light: #57534e;
    --hanger-mid: #2a2826;
    --hanger-dark: #0d0c0b;
  }

  .clothing-rack--hanger-wood {
    --hanger-light: #e2b47c;
    --hanger-mid: #a86d38;
    --hanger-dark: #5e3a1b;
  }

  .clothing-rack--hanger-chrome {
    --hanger-light: #fbfbfb;
    --hanger-mid: #a7a7a7;
    --hanger-dark: #4f4f4f;
  }

  .clothing-rack__stage {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 0 32px;
  }

  .clothing-rack__heading {
    margin: 0 0 32px;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
  }

  /* ---------- Rack ---------- */
  .clothing-rack__rail-wrap {
    width: 100%;
    transition: opacity 0.5s var(--rack-ease), transform 0.6s var(--rack-ease), filter 0.5s;
  }

  .clothing-rack__scroller {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 48px;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
  }

  .clothing-rack__scroller::-webkit-scrollbar {
    display: none;
  }

  .clothing-rack__track {
    position: relative;
    width: max-content;
    margin: 0 auto;
  }

  .clothing-rack__rail {
    z-index: 0;
    position: absolute;
    top: calc(var(--hanger-w) * 0.05 - 4px);
    left: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    height: 8px;
    pointer-events: none;
  }

  /* wall shadow cast by the rail */
  .clothing-rack__rail::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    z-index: -1;
    height: 6px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.22);
    filter: blur(5px);
  }

  .clothing-rack__rail-bar {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(
      180deg,
      #fdfdfd 0%,
      #d9d9d9 22%,
      #8f8f8f 52%,
      #bdbdbd 72%,
      #6a6a6a 100%
    );
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.25);
  }

  .clothing-rack__bracket {
    position: relative;
    flex: 0 0 auto;
    width: 12px;
    height: 30px;
    border-radius: 3px;
    background: linear-gradient(90deg, #7a7a7a 0%, #f2f2f2 35%, #b0b0b0 60%, #5e5e5e 100%);
    box-shadow:
      3px 6px 8px rgb(0 0 0 / 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.6);
  }

  .clothing-rack__bracket::before,
  .clothing-rack__bracket::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #777 70%);
  }

  .clothing-rack__bracket::before {
    top: 4px;
  }

  .clothing-rack__bracket::after {
    bottom: 4px;
  }

  .clothing-rack__items {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
    margin: 0;
    padding: 0 16px;
    list-style: none;
  }

  .clothing-rack__item {
    position: relative;
    flex: 0 0 auto;
    width: var(--rack-collapsed);
    height: calc(var(--rack-garment-h) + var(--hanger-w) * 0.26 + 36px);
    transition: width 0.6s var(--rack-ease);
  }

  .clothing-rack__garment {
    all: unset;
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .clothing-rack__garment--placeholder {
    cursor: default;
  }

  /* Every layer of a garment (shadow, photo, hanger) turns together */
  .clothing-rack__turn {
    --turn: 72deg;
    --lift: 0px;
    position: absolute;
    left: 50%;
    display: block;
    transform: translateX(-50%) translateY(var(--lift)) perspective(900px) rotateY(var(--turn));
    transition: transform 0.6s var(--rack-ease), opacity 0.6s var(--rack-ease);
    pointer-events: none;
  }

  .clothing-rack__hanger-wrap {
    top: 0;
    width: var(--hanger-w);
  }

  .clothing-rack__hanger {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .clothing-rack__img {
    top: calc(var(--hanger-w) * 0.26);
    width: var(--rack-open);
    height: var(--rack-garment-h);
    object-fit: contain;
    object-position: top center;
    user-select: none;
  }

  /* soft shadow the garment casts on the wall */
  .clothing-rack__shadow {
    top: calc(var(--hanger-w) * 0.3);
    width: calc(var(--rack-open) * 0.72);
    height: calc(var(--rack-garment-h) * 0.86);
    border-radius: 38% 38% 14% 14% / 16% 16% 10% 10%;
    background: rgb(0 0 0 / 0.5);
    filter: blur(18px);
    opacity: 0.22;
    transform: translateX(calc(-50% + 8px)) translateY(10px) perspective(900px) rotateY(var(--turn));
  }

  .clothing-rack--blend .clothing-rack__img,
  .clothing-rack--blend .clothing-rack__hero-img,
  .clothing-rack--blend .clothing-rack__ghost {
    mix-blend-mode: multiply;
  }

  .clothing-rack__img--placeholder {
    fill: rgb(0 0 0 / 0.35);
    background: rgb(0 0 0 / 0.04);
  }

  .clothing-rack__label {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 6px);
    white-space: nowrap;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s, transform 0.4s var(--rack-ease);
    pointer-events: none;
  }

  /* Pull-out on hover / keyboard focus */
  @media (hover: hover) {
    .clothing-rack__item:has(.clothing-rack__garment:not(.clothing-rack__garment--placeholder):hover) {
      width: var(--rack-open);
    }

    .clothing-rack__garment:hover .clothing-rack__turn {
      --turn: 0deg;
      --lift: 4px;
    }

    .clothing-rack__garment:hover .clothing-rack__shadow {
      opacity: 0.38;
      transform: translateX(calc(-50% + 18px)) translateY(22px) perspective(900px) rotateY(0deg);
    }

    .clothing-rack__garment:hover .clothing-rack__label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .clothing-rack__item:has(.clothing-rack__garment:focus-visible) {
    width: var(--rack-open);
  }

  .clothing-rack__garment:focus-visible .clothing-rack__turn {
    --turn: 0deg;
  }

  .clothing-rack__garment:focus-visible .clothing-rack__label {
    opacity: 1;
    transform: translate(-50%, 0);
    text-decoration: underline;
  }

  .clothing-rack__hint {
    margin: 24px 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
    transition: opacity 0.4s;
  }

  /* ---------- Focus (close-up) view ---------- */
  .clothing-rack.is-focused .clothing-rack__rail-wrap {
    opacity: 0;
    transform: scale(0.96);
    filter: blur(6px);
    pointer-events: none;
  }

  .clothing-rack.is-focused .clothing-rack__hint,
  .clothing-rack.is-focused .clothing-rack__heading {
    opacity: 0;
  }

  .clothing-rack__focus {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 56px 16px 24px;
    opacity: 0;
    transition: opacity 0.45s var(--rack-ease);
  }

  .clothing-rack__focus[hidden] {
    display: none;
  }

  .clothing-rack.is-open .clothing-rack__focus {
    opacity: 1;
  }

  .clothing-rack__close {
    all: unset;
    position: absolute;
    top: 18px;
    right: 24px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 6px;
  }

  .clothing-rack__close:focus-visible,
  .clothing-rack__arrow:focus-visible,
  .clothing-rack__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .clothing-rack__arrow {
    all: unset;
    position: absolute;
    top: 45%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid currentColor;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s, transform 0.2s;
  }

  .clothing-rack__arrow[hidden] {
    display: none;
  }

  .clothing-rack__arrow:hover {
    opacity: 1;
    transform: scale(1.06);
  }

  .clothing-rack__arrow--prev {
    left: max(16px, 4vw);
  }

  .clothing-rack__arrow--next {
    right: max(16px, 4vw);
  }

  .clothing-rack__focus-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    max-width: 900px;
    height: min(calc(var(--rack-garment-h) * 1.35), 58svh);
  }

  .clothing-rack__hero {
    --hero-hanger-w: min(200px, 42vw);
    position: relative;
    height: 100%;
    width: min(70vw, 520px);
    margin: 0;
  }

  .clothing-rack__hero > * {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    transition: opacity 0.35s var(--rack-ease), transform 0.5s var(--rack-ease);
  }

  .clothing-rack__hero .clothing-rack__hanger {
    top: 0;
    width: var(--hero-hanger-w);
  }

  .clothing-rack__hero-img {
    top: calc(var(--hero-hanger-w) * 0.26);
    height: calc(100% - var(--hero-hanger-w) * 0.26);
    width: 100%;
    object-fit: contain;
    object-position: top center;
  }

  .clothing-rack__hero-shadow {
    top: calc(var(--hero-hanger-w) * 0.34);
    width: 62%;
    height: 82%;
    border-radius: 38% 38% 14% 14% / 16% 16% 10% 10%;
    background: rgb(0 0 0 / 0.5);
    filter: blur(26px);
    opacity: 0.3;
    transform: translateX(calc(-50% + 22px)) translateY(20px);
  }

  .clothing-rack__hero.is-swapping > * {
    opacity: 0;
    transform: translateX(calc(-50% + var(--rack-swap-dir, 0px))) scale(0.97);
  }

  .clothing-rack__ghost {
    position: absolute;
    top: 30px;
    height: calc(100% - 50px);
    width: auto;
    max-width: 28%;
    object-fit: contain;
    opacity: 0.35;
    filter: blur(5px);
    transform: perspective(900px) rotateY(60deg) scale(0.85);
    pointer-events: none;
    transition: opacity 0.4s;
  }

  .clothing-rack__ghost--prev {
    left: 14%;
  }

  .clothing-rack__ghost--next {
    right: 14%;
  }

  .clothing-rack__ghost:not([src]),
  .clothing-rack__ghost[src=''] {
    visibility: hidden;
  }

  .clothing-rack__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .clothing-rack__title {
    margin: 0;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
  }

  .clothing-rack__price {
    margin: 0;
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
  }

  .clothing-rack__compare {
    opacity: 0.5;
  }

  .clothing-rack__compare:empty {
    display: none;
  }

  .clothing-rack__soldout {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .clothing-rack__actions {
    display: flex;
    gap: 8px;
  }

  .clothing-rack__btn {
    all: unset;
    box-sizing: border-box;
    padding: 9px 20px;
    border: 1px solid var(--rack-fg);
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .clothing-rack__btn:hover,
  .clothing-rack__btn--solid {
    background: var(--rack-fg);
    color: var(--rack-bg);
  }

  .clothing-rack__btn--solid:hover {
    background: transparent;
    color: var(--rack-fg);
  }

  .clothing-rack__btn[hidden] {
    display: none;
  }

  /* ---------- Ticker ---------- */
  .clothing-rack__ticker {
    position: relative;
    z-index: 4;
    overflow: hidden;
    background: var(--rack-ticker-bg);
    color: var(--rack-ticker-fg);
    padding: 7px 0;
  }

  .clothing-rack__ticker-track {
    display: flex;
    width: max-content;
    animation: clothing-rack-ticker 40s linear infinite;
  }

  .clothing-rack__ticker-group {
    display: flex;
    flex-shrink: 0;
  }

  .clothing-rack__ticker-group span {
    padding: 0 12px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes clothing-rack-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Phones ---------- */
  @media (max-width: 749px) {
    .clothing-rack {
      --rack-collapsed: 40px;
      --rack-garment-h: 250px !important;
      min-height: min(var(--rack-height), 80svh);
    }

    .clothing-rack__scroller {
      width: 100%;
      padding: 0 16px;
      scroll-snap-type: x proximity;
    }

    .clothing-rack__items {
      justify-content: flex-start;
      width: max-content;
      padding: 0 24px;
    }

    .clothing-rack__item {
      scroll-snap-align: center;
    }

    .clothing-rack__turn {
      --turn: 76deg;
    }

    .clothing-rack__ghost {
      display: none;
    }

    .clothing-rack__arrow {
      top: auto;
      bottom: 28px;
    }

    .clothing-rack__arrow--prev {
      left: 16px;
    }

    .clothing-rack__arrow--next {
      right: 16px;
    }

    .clothing-rack__hero-img {
      max-width: 78vw;
    }
  }

  /* ---------- Brand fonts ---------- */
  .clothing-rack--brand-fonts {
    --rack-font-display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    --rack-font-mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    font-family: var(--rack-font-mono);
  }

  .clothing-rack--brand-fonts .clothing-rack__heading,
  .clothing-rack--brand-fonts .clothing-rack__title,
  .clothing-rack--brand-fonts .clothing-rack__label,
  .clothing-rack--brand-fonts .clothing-rack__ticker-group span {
    font-family: var(--rack-font-display);
    font-weight: 400;
  }

  .clothing-rack--brand-fonts .clothing-rack__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .clothing-rack--brand-fonts .clothing-rack__label {
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .clothing-rack--brand-fonts .clothing-rack__heading {
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.08em;
  }

  .clothing-rack--brand-fonts .clothing-rack__ticker-group span {
    font-size: 1.05rem;
    letter-spacing: 0.12em;
  }

  .clothing-rack--brand-fonts .clothing-rack__btn,
  .clothing-rack--brand-fonts .clothing-rack__close,
  .clothing-rack--brand-fonts .clothing-rack__hint,
  .clothing-rack--brand-fonts .clothing-rack__price {
    font-family: var(--rack-font-mono);
  }

  .clothing-rack__ticker-sep {
    color: var(--rack-accent);
  }

  .clothing-rack__btn--solid:hover,
  .clothing-rack__btn--solid:focus-visible {
    background: var(--rack-accent);
    border-color: var(--rack-accent);
    color: var(--rack-bg);
  }

  .clothing-rack__soldout {
    color: var(--rack-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .clothing-rack *,
    .clothing-rack {
      transition-duration: 0.01ms !important;
    }

    .clothing-rack__ticker-track {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('clothing-rack')) {
    class ClothingRack extends HTMLElement {
      connectedCallback() {
        const dataEl = this.querySelector('[data-rack-products]');
        this.focusEl = this.querySelector('.clothing-rack__focus');
        if (!dataEl || !this.focusEl) return;

        try {
          this.products = JSON.parse(dataEl.textContent);
        } catch (e) {
          this.products = [];
        }
        if (!this.products.length) return;

        this.index = 0;
        this.showingBack = false;
        this.els = {
          hero: this.querySelector('[data-rack-hero]'),
          heroImg: this.querySelector('[data-rack-hero-img]'),
          ghostPrev: this.querySelector('[data-rack-ghost-prev]'),
          ghostNext: this.querySelector('[data-rack-ghost-next]'),
          title: this.querySelector('[data-rack-title]'),
          price: this.querySelector('[data-rack-price]'),
          compare: this.querySelector('[data-rack-compare]'),
          soldout: this.querySelector('[data-rack-soldout]'),
          link: this.querySelector('[data-rack-link]'),
          flip: this.querySelector('[data-rack-flip]'),
        };
        this.backLabel = this.els.flip.textContent.trim();

        this.onClick = (event) => {
          const garment = event.target.closest('.clothing-rack__garment[data-index]');
          if (garment) {
            this.lastTrigger = garment;
            this.open(Number(garment.dataset.index));
            return;
          }
          if (event.target.closest('[data-rack-close]')) this.close();
          else if (event.target.closest('[data-rack-prev]')) this.step(-1);
          else if (event.target.closest('[data-rack-next]')) this.step(1);
          else if (event.target.closest('[data-rack-flip]')) this.flip();
        };

        this.onKey = (event) => {
          if (!this.classList.contains('is-focused')) return;
          if (event.key === 'Escape') this.close();
          else if (event.key === 'ArrowLeft') this.step(-1);
          else if (event.key === 'ArrowRight') this.step(1);
        };

        this.addEventListener('click', this.onClick);
        document.addEventListener('keydown', this.onKey);

        let touchX = null;
        this.focusEl.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
        this.focusEl.addEventListener('touchend', (e) => {
          if (touchX === null) return;
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 50) this.step(dx < 0 ? 1 : -1);
          touchX = null;
        });
      }

      disconnectedCallback() {
        if (this.onKey) document.removeEventListener('keydown', this.onKey);
      }

      wrap(i) {
        const n = this.products.length;
        return ((i % n) + n) % n;
      }

      render() {
        const p = this.products[this.index];
        const n = this.products.length;
        this.showingBack = false;

        this.els.heroImg.src = p.front;
        this.els.heroImg.alt = p.alt || p.title;
        this.els.title.textContent = p.title;
        this.els.price.textContent = p.price;
        this.els.compare.textContent = p.compare || '';
        this.els.soldout.hidden = p.available;
        this.els.link.href = p.url;
        this.els.flip.hidden = !p.back;
        this.els.flip.textContent = this.backLabel;

        if (n > 1) {
          this.els.ghostPrev.src = this.products[this.wrap(this.index - 1)].front;
          this.els.ghostNext.src = this.products[this.wrap(this.index + 1)].front;
        } else {
          this.els.ghostPrev.removeAttribute('src');
          this.els.ghostNext.removeAttribute('src');
        }

        this.querySelectorAll('[data-rack-prev], [data-rack-next]').forEach((b) => (b.hidden = n < 2));
      }

      open(i) {
        this.index = this.wrap(i);
        this.render();
        this.focusEl.hidden = false;
        this.classList.add('is-focused');
        requestAnimationFrame(() => {
          this.classList.add('is-open');
          this.querySelector('[data-rack-close]').focus({ preventScroll: true });
        });
      }

      close() {
        this.classList.remove('is-open', 'is-focused');
        clearTimeout(this.hideTimer);
        this.hideTimer = setTimeout(() => {
          if (!this.classList.contains('is-focused')) this.focusEl.hidden = true;
        }, 450);
        if (this.lastTrigger) this.lastTrigger.focus({ preventScroll: true });
      }

      step(dir) {
        if (this.products.length < 2 || this.swapping) return;
        this.swapping = true;
        const hero = this.els.hero;
        hero.style.setProperty('--rack-swap-dir', `${dir * -40}px`);
        hero.classList.add('is-swapping');
        setTimeout(() => {
          this.index = this.wrap(this.index + dir);
          this.render();
          hero.style.setProperty('--rack-swap-dir', `${dir * 40}px`);
          requestAnimationFrame(() => {
            hero.classList.remove('is-swapping');
            this.swapping = false;
          });
        }, 220);
      }

      flip() {
        const p = this.products[this.index];
        if (!p.back) return;
        this.showingBack = !this.showingBack;
        this.els.heroImg.src = this.showingBack ? p.back : p.front;
        this.els.flip.textContent = this.showingBack ? 'Front' : this.backLabel;
      }
    }

    customElements.define('clothing-rack', ClothingRack);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Clothing rack",
  "tag": "section",
  "class": "section-clothing-rack",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products. Photos with a white or transparent background look best."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Items on the rack",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "blend_backgrounds",
      "label": "Hide white photo backgrounds",
